# ==========================================
# QUORUM - Configuration & Secrets
# ==========================================

# Google Gemini API Key (Get a free key at: https://aistudio.google.com/)
# If empty, Quorum automatically operates in offline simulation mode.
GEMINI_API_KEY=

# Default Gemini Model
GEMINI_MODEL=gemini-2.5-flash

# Environment Mode: development / production
APP_ENV=production
DEBUG=false

# LLM Performance & Concurrency
LLM_CONCURRENCY=4
LLM_TIMEOUT_SECONDS=25.0

# Server Configuration
HOST=127.0.0.1
PORT=8000

# CORS Allowed Origins (Comma-separated, localhost only)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Security & Upload Limits
MAX_UPLOAD_MB=10
MAX_BRIEF_LENGTH=5000
