# ==========================================
# QUORUM - Configuration & Secrets
# ==========================================

# Google Gemini API Key (Get free key at: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini Model (free tier friendly with high token allowance)
# Options: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Environment Mode: development / production / mock
# When set to mock or if GEMINI_API_KEY is not set, Quorum runs in deterministic mock mode
APP_ENV=development

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (Comma-separated for Google Stitch and local frontends)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://stitch.withgoogle.com,*
